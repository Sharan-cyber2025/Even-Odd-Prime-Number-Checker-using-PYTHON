def even_odd(n):
    if n % 2 == 0:
        print("Even number")
    else:
        print("Odd number")
def prime(n):
    if n > 1:
        for i in range(2, n):
            if n % i == 0:
                return False
        return True
    return False
m= int(input("Enter a number: "))
even_odd(m)
if prime(m):
    print("Prime number")
else:
    print("Not a prime number")
